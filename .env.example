# The Runish — переменные окружения
# Скопируйте в .env и заполните значениями

# База данных
DATABASE_URL=postgres://postgres:postgres@localhost:5432/therunish?sslmode=disable

# HTTP сервер
HTTP_ADDR=:8080
BASE_URL=http://localhost:8080

# Сессии (TTL — duration, например 720h = 30 дней)
SESSION_TTL=720h

# Telegram бот (от @BotFather)
BOT_TOKEN=
BOT_USERNAME=therunish_bot

# Mini App: включает POST /api/auth/dev — вход без Telegram для локальной проверки
# /app в обычном браузере. НЕ включать в проде.
DEV_AUTH_BYPASS=

# Вход через ВКонтакте (VK ID, OAuth 2.1 + PKCE — приложение на https://id.vk.com)
# ID приложения и защищённый ключ. В доверенные redirect URI добавьте <BASE_URL>/api/auth/vk/callback.
# Пусто = вход через ВК выключен.
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# T-Bank эквайринг
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_BASE=https://securepay.tinkoff.ru/v2

# 54-ФЗ: фискальные параметры чека
# Taxation: osn | usn_income | usn_income_costs | patent | envd | esn
TBANK_TAXATION=usn_income
# Tax (НДС): none | vat0 | vat10 | vat20 | vat110 | vat118
TBANK_TAX=none
# PaymentObject: service | commodity | excise | job | gambling_bet | ...
TBANK_PAYMENT_OBJECT=service
# PaymentMethod: full_payment | full_prepayment | prepayment | partial_prepayment
TBANK_PAYMENT_METHOD=full_payment

# Admin-токен (для серверной ручки управления каталогом)
ADMIN_TOKEN=

# Admin-панель (вход по логину/паролю, без Telegram)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Провайдер платежей: tbank | mock
PAYMENT_PROVIDER=mock

# Встроенный воркер: RUN_WORKER=1 — web сам крутит бота/напоминания/истечение/GetState
# горутиной (один процесс на один core, например на Amvera). Пусто/0 — воркер запускается
# отдельным процессом (cmd/worker, сервис worker в docker-compose).
# ВАЖНО: при RUN_WORKER=1 нельзя поднимать >1 реплики web (задвоится поллинг бота).
RUN_WORKER=

# Пароль локального Postgres (docker-compose)
POSTGRES_PASSWORD=postgres

# ─── Отслеживание ошибок ───
# Sentry DSN (sentry.io → Create Project → Go → Client Keys). Пусто = Sentry выключен.
SENTRY_DSN=
# Окружение в Sentry (production | staging | dev).
SENTRY_ENVIRONMENT=production
# Отдельный Telegram-бот для алертов об ошибках (НЕ основной бот).
# Токен от @BotFather и chat_id, куда слать (узнать через @userinfobot или getUpdates).
# Пусто = алерты в Telegram выключены.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
# Уровень логов: DEBUG | INFO | WARN | ERROR (по умолчанию INFO).
LOG_LEVEL=INFO
